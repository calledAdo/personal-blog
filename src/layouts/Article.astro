---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, date, abstract, tags, authors } = article.data;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={abstract}>
  <article>
    <header class="mb-10 border-b border-stone-200 pb-8 dark:border-stone-800">
      <h1 class="font-sans text-4xl font-bold leading-tight tracking-tight">
        {title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-sm text-stone-500">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {authors.length > 0 && <span>· {authors.join(', ')}</span>}
      </div>

      {tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="rounded-full bg-stone-200 px-3 py-0.5 font-sans text-xs text-stone-600 hover:bg-stone-300 dark:bg-stone-800 dark:text-stone-400 dark:hover:bg-stone-700"
            >
              {tag}
            </a>
          ))}
        </div>
      )}

      {abstract && (
        <p class="mt-6 border-l-2 border-stone-300 pl-4 font-sans text-base italic text-stone-600 dark:border-stone-700 dark:text-stone-400">
          {abstract}
        </p>
      )}
    </header>

    <div class="prose prose-stone max-w-none prose-headings:font-sans prose-headings:tracking-tight prose-a:text-blue-700 prose-pre:bg-stone-900 dark:prose-invert dark:prose-a:text-blue-400">
      <slot />
    </div>
  </article>

  <div class="mt-12 border-t border-stone-200 pt-6 font-sans text-sm dark:border-stone-800">
    <a href="/" class="text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100">← All articles</a>
  </div>
</Base>
