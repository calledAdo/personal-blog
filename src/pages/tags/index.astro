---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Index of every tag with a count, sorted by frequency.
const articles = (await getCollection('articles')).filter((a) => !a.data.draft);

const counts = new Map<string, number>();
for (const a of articles) {
  for (const tag of a.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title="Tags" description="Browse articles by tag.">
  <div class="mb-10">
    <h1 class="font-sans text-3xl font-bold tracking-tight">Tags</h1>
    <p class="mt-2 text-stone-600 dark:text-stone-400">Browse articles by topic.</p>
  </div>

  {tags.length === 0 ? (
    <p class="text-stone-500">No tags yet.</p>
  ) : (
    <div class="flex flex-wrap gap-3">
      {tags.map(([tag, count]) => (
        <a
          href={`/tags/${tag}`}
          class="rounded-full bg-stone-200 px-4 py-1.5 font-sans text-sm text-stone-700 hover:bg-stone-300 dark:bg-stone-800 dark:text-stone-300 dark:hover:bg-stone-700"
        >
          {tag} <span class="text-stone-500">{count}</span>
        </a>
      ))}
    </div>
  )}
</Base>
